# Copy this file to `.env` and adjust if needed.
# `.env` is gitignored — never commit real credentials.

# Which deployed version to target.
# Options: local | v1 | v2 | v3 | v4 | v5 | with-bugs
TEST_ENV=v5

# Optional explicit overrides. Leave commented to use the defaults for TEST_ENV.
# BASE_URL=https://practicesoftwaretesting.com
# API_URL=https://api.practicesoftwaretesting.com

# Seeded accounts that ship with the application.
# These defaults work out of the box against the hosted versions.
ADMIN_EMAIL=admin@practicesoftwaretesting.com
ADMIN_PASSWORD=welcome01

CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
CUSTOMER_PASSWORD=welcome01
